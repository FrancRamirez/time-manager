# URL base del backend serverless (Vercel)
EXPO_PUBLIC_API_URL=https://time-manager-api.vercel.app

# Client ID de Google Sign-In (tipo "Android" en Google Cloud Console)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Client ID de tipo "Web" (necesario para que Google Sign-In devuelva un idToken válido)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
